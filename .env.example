# =============================================
# GREENMIND - ENVIRONMENT TEMPLATE
# =============================================
# Copy this file to .env and fill in the values.

# --- Django Core ---
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SQL Server) ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=GRW

# --- CORS Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT Settings ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CO2 Calculation Model ---
STORAGE_KWH_PER_UNIT=0.002
GRID_EMISSION_VN=0.4937
EMISSION_FACTOR_DEMO=0.85

# --- Abivin vRoute Integration ---
VROUTE_ENABLED=false
VROUTE_API_KEY=
VROUTE_API_URL=https://api.abivin.com/v1/orders
